// NEXUS Agency — 6-Language (TR, EN, DE, RU, ZH, FR) i18n Translation Engine

pub fn normalize_lang(code: String) -> String {
  case code {
    "en" -> "en"
    "de" -> "de"
    "ru" -> "ru"
    "zh" -> "zh"
    "ar" -> "ar"
    "fr" -> "fr"
    _ -> "tr"
  }
}

pub fn is_rtl(lang: String) -> Bool {
  lang == "ar"
}

pub fn flag_icon(lang: String) -> String {
  case lang {
    "en" -> "🇬🇧"
    "de" -> "🇩🇪"
    "ru" -> "🇷🇺"
    "zh" -> "🇨🇳"
    "ar" -> "🇸🇦"
    "fr" -> "🇫🇷"
    _ -> "🇹🇷"
  }
}

pub fn lang_name(lang: String) -> String {
  case lang {
    "en" -> "English"
    "de" -> "Deutsch"
    "ru" -> "Русский"
    "zh" -> "简体中文"
    "ar" -> "العربية"
    "fr" -> "Français"
    _ -> "Türkçe"
  }
}

pub fn supported_languages() -> List(#(String, String, String)) {
  [
    #("tr", "🇹🇷", "Türkçe"),
    #("en", "🇬🇧", "English"),
    #("de", "🇩🇪", "Deutsch"),
    #("ru", "🇷🇺", "Русский"),
    #("zh", "🇨🇳", "简体中文"),
    #("fr", "🇫🇷", "Français"),
  ]
}

//// Panel bölüm başlığı — slug'dan çeviri anahtarına.
////
//// `panel.section` dispeç (form seçimi) ve varlık seçimi (script/CSS) için
//// slug kullanır; görünür başlık yalnızca buradan, seçili dille üretilir.
//// Böylece başlık çevrilebilir hâle gelirken yönlendirme anahtarı sabit kalır
//// (eskiden Türkçe başlık hem görünen metin hem de dispeç anahtarıydı, bu
//// yüzden dil değişince yanlış form/varlık seçilirdi).
pub fn section_heading_key(section: String) -> String {
  case section {
    "catalog" | "listings" -> "catalog"
    "reservations" -> "reservations"
    "customers" -> "customers"
    "regions" -> "regions"
    "team" -> "team"
    "settings" -> "settings"
    "languages" -> "languages"
    "currencies" -> "currencies"
    "categories" -> "categories"
    "cms" -> "cms"
    "campaigns" -> "campaigns"
    "supplier-campaigns" -> "section_supplier_campaigns"
    "integrations" -> "integrations"
    "sync" -> "sync_status"
    "ai" -> "ai"
    "reports" -> "reports"
    "media" -> "media"
    "abandoned-carts" -> "abandoned_carts"
    "sub-agencies" -> "sub_agencies"
    "supplier-onboarding" -> "supplier_onboarding"
    "popups" -> "popups"
    "offers" -> "offers"
    "inquiries" -> "inquiries"
    "notifications" -> "notification_center"
    "search-analytics" -> "search_analytics"
    _ -> "section_fallback"
  }
}

/// Panel bölüm başlığını seçili dilde döndürür.
pub fn section_title(lang: String, section: String) -> String {
  t(lang, section_heading_key(section))
}

pub fn campaign_label(lang: String, cat_key: String) -> String {
  let cat_name = t(lang, cat_key)
  case normalize_lang(lang) {
    "en" -> cat_name <> " campaigns"
    "de" -> cat_name <> " Aktionen"
    "ru" -> cat_name <> " акции"
    "zh" -> cat_name <> "促销活动"
    "ar" -> "عروض " <> cat_name
    "fr" -> cat_name <> " campagnes"
    _ -> cat_name <> " detay kampanyaları"
  }
}

