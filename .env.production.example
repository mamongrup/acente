# Copy to .env on the server and replace every CHANGE_ME value. Never package .env.
APP_ENV=production
APP_PORT=8082
APP_ORIGIN=https://agency.example.com
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nexus_agency
PGUSER=agency_app
PGPASSWORD=CHANGE_ME_RUNTIME_DB_PASSWORD
SECRET_KEY_BASE=CHANGE_ME_64_RANDOM_CHARACTERS
NEXUS_CONFIG_KEY=CHANGE_ME_64_RANDOM_CHARACTERS_KEEP_STABLE
TRUSTED_PROXY_SECURE_COOKIES=true
TRUST_PROXY_HEADERS=true
EDGE_RATE_LIMIT_ENABLED=true
# Leave both empty for a standalone agency. Configure both to connect to NEXUS.
NEXUS_API_ORIGIN=
NEXUS_API_KEY=
NEXUS_TENANT_ID=
