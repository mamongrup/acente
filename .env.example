[TEMPLATE]
APP_ENV=development
APP_PORT=8082
APP_ORIGIN=http://127.0.0.1:8082
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nexus_agency
PGUSER=agency_app
PGPASSWORD=generated-by-setup
SECRET_KEY_BASE=replace-with-at-least-64-random-characters
NEXUS_CONFIG_KEY=replace-with-at-least-64-random-characters
# Meta webhook doğrulaması. Her acente kendi onaylı WhatsApp şablonunu
# Entegrasyonlar ekranında seçer; bu iki sır uygulama dağıtımına aittir.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
NEXUS_API_ORIGIN=http://127.0.0.1:8081
TRUSTED_PROXY_SECURE_COOKIES=false
# Enable only when a trusted reverse proxy/CDN overwrites (not appends user
# input to) X-Forwarded-For and CF-Connecting-IP before forwarding requests.
TRUST_PROXY_HEADERS=false
EDGE_RATE_LIMIT_ENABLED=false
# Agency-scoped API key issued by NEXUS. Used for listing feed,
# inventory sync and reservation webhook delivery.
NEXUS_API_KEY=
# Agency tenant UUID that NEXUS listings are synced into. Sync stays disabled
# until this is set (prevents accidental writes to every tenant).
NEXUS_TENANT_ID=
# AI translation service for category filter labels (5 languages).
# Leave empty to run in fallback mode (source text preserved, status=skipped).
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash-lite
